{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "allowJs": true, "allowImportingTsExtensions": true, "types": ["node", "react", "react-dom"],
    "noEmit": true, "esModuleInterop": true
  },
  "include": ["src", "preview"],
  "exclude": ["node_modules", "artifacts", "lib"]
}
