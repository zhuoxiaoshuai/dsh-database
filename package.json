{
  "name": "dsh-database",
  "version": "0.1.0-alpha.12.15",
  "license": "MIT",
  "author": "liu",
  "description": "MySQL, Oracle, Redis, and Kafka workbench for DeepSeek Harness, with a shared execution path for humans and the model.",
  "homepage": "https://github.com/zhuoxiaoshuai/dsh-database#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhuoxiaoshuai/dsh-database.git"
  },
  "bugs": {
    "url": "https://github.com/zhuoxiaoshuai/dsh-database/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mysql",
    "oracle",
    "redis",
    "kafka"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/connection-worker.mjs",
    "lib/redis-worker.mjs",
    "lib/kafka-worker.mjs",
    "lib/connect-error.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "lib/catalog.mjs",
    "lib/query.mjs",
    "lib/query-pool.mjs",
    "lib/session-manager.mjs",
    "lib/query-policy.mjs",
    "lib/browse.mjs",
    "lib/maintenance.mjs",
    "lib/maintenance-capability.mjs",
    "lib/dml-plan.mjs",
    "lib/ddl-plan.mjs",
    "lib/primary-keys.mjs",
    "lib/oracle-temporal.mjs",
    "lib/request-timeouts.mjs",
    "lib/cell-value.mjs",
    "lib/dialects",
    "lib/data-sources",
    "lib/shared/connection-permission.mjs",
    "lib/shared/limits.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "preview": "node scripts/preview.mjs",
    "probe": "node scripts/probe.mjs",
    "test:ui": "node scripts/query-layout-acceptance.mjs",
    "test:completion-ui": "node scripts/completion-ui-acceptance.mjs",
    "test:host": "node scripts/host-acceptance.mjs",
    "test:mysql": "node scripts/mysql-acceptance.mjs",
    "test:oracle": "node scripts/oracle-acceptance.mjs",
    "test:redis": "node scripts/redis-fixture-acceptance.mjs",
    "test:workspace-ui": "node scripts/unified-workspace-ui-acceptance.mjs",
    "test:source-module": "node scripts/source-module-ui-acceptance.mjs",
    "test:workspace-races": "node scripts/workspace-race-ui-acceptance.mjs",
    "test:kafka-tree": "node scripts/kafka-catalog-tree-acceptance.mjs",
    "test:kafka": "node scripts/kafka-acceptance.mjs",
    "test:package-closure": "node --experimental-strip-types --test test/package-runtime-closure.test.mjs && node scripts/package-closure.mjs",
    "test:package": "node scripts/host-acceptance.mjs",
    "install:desktop": "node scripts/install-desktop.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@griffithswaite/ts-plsql-parser": "1.1.1",
    "@lezer/highlight": "1.2.3",
    "antlr4": "4.13.0",
    "kafkajs": "2.2.4",
    "lucide-react": "1.45.0",
    "mysql2": "3.24.4",
    "node-sql-parser": "5.4.0",
    "oracledb": "7.0.1",
    "redis": "6.2.1",
    "sql-formatter": "15.8.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-util-values": "0.1.2-rc.1",
    "@types/node": "24.13.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1 || 0.1.7-rc.2 || 0.2.0-rc.1 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1 || 0.1.7-rc.2 || 0.2.0-rc.1 || 0.2.0-rc.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
